filters:
  and:
    - file.ext == "md"
    - or:
        - file.inFolder("ai-workspace-hub/inbox")
        - file.inFolder("ai-workspace-hub/output/research")
        - file.inFolder("ai-workspace-hub/output/screen")
        - file.inFolder("ai-workspace-hub/output/pod2wiki")
        - file.inFolder("ai-workspace-hub/output/daily-watch")
        - file.inFolder("ai-workspace-hub/output/ai-signal")
        - file.inFolder("ai-workspace-hub/output/podcast-picks")
        - file.inFolder("ai-workspace-hub/output/hypothesis-review")
        - file.inFolder("ai-workspace-hub/workspace/monitoring")
        - file.inFolder("ai-workspace-hub/wiki/sources")
formulas:
  status: if(read_status, read_status, "未读")
  status_icon: if(read_status == "已读", "✅", if(read_status == "精读", "⭐", if(read_status == "跳过", "⏭️", "📄")))
  category: if(/(^|\/)inbox\//.matches(file.path), "📥 Inbox", if(/output\/research/.matches(file.path), "🔬 研究", if(/output\/screen/.matches(file.path), "🔍 筛选", if(/output\/pod2wiki/.matches(file.path), "📚 Wiki", if(/output\/podcast-picks/.matches(file.path), "🎯 播客选品", if(/(output\/daily-watch|output\/ai-signal|workspace\/monitoring)/.matches(file.path), "📊 日报监控", if(/wiki\/sources/.matches(file.path), if(pick_status == "published", "🚀 已发布", if(pick_status == "transcribed", "📝 已转录", "📚 Sources")), if(/output\/hypothesis-review/.matches(file.path), "📈 假设复盘", "🗂️ 其他"))))))))
  days_old: (now() - file.ctime).days.round(0)
properties:
  read_status:
    displayName: 阅读状态
  pick_status:
    displayName: 选品状态
  title_zh:
    displayName: 标题
  tldr_zh:
    displayName: 摘要
  channel:
    displayName: 节目
  guest:
    displayName: 嘉宾
  priority:
    displayName: 优先级
  duration_min:
    displayName: 时长(分)
  date:
    displayName: 播出/发布日期
  formula.status:
    displayName: 状态
  formula.category:
    displayName: 类别
  formula.days_old:
    displayName: 入库天数
  report_id:
    displayName: 报告ID
  iso_week:
    displayName: 周次
  period:
    displayName: 复盘区间
  certainty_changes:
    displayName: 确定性变动
  article:
    displayName: 公众号文稿
  wechat_draft_id:
    displayName: 微信草稿ID
  podcast_pick:
    displayName: 关联播客
views:
  - type: table
    name: 🎯 今日看什么
    filters:
      and:
        - (now() - file.ctime).days <= 3
        - formula.status != "已读"
        - formula.status != "跳过"
    order:
      - formula.status_icon
      - file.name
      - formula.category
      - formula.days_old
    sort:
      - property: file.ctime
        direction: DESC
    limit: 20
  - type: table
    name: 📊 日报监控
    filters:
      or:
        - file.inFolder("ai-workspace-hub/output/daily-watch")
        - file.inFolder("ai-workspace-hub/output/ai-signal")
        - file.inFolder("ai-workspace-hub/workspace/monitoring")
    order:
      - file.name
      - formula.category
      - file.ctime
    sort:
      - property: file.ctime
        direction: DESC
    limit: 14
  - type: table
    name: 📈 假设复盘
    filters:
      and:
        - file.inFolder("ai-workspace-hub/output/hypothesis-review")
    order:
      - formula.status_icon
      - file.name
      - iso_week
      - period
      - report_id
      - certainty_changes
      - formula.category
      - file.mtime
    sort:
      - property: file.mtime
        direction: DESC
    limit: 12
  - type: table
    name: 📥 Inbox（未读）
    filters:
      and:
        - file.inFolder("ai-workspace-hub/inbox")
        - formula.status == "未读"
    order:
      - formula.status_icon
      - file.name
      - formula.days_old
    sort:
      - property: file.ctime
        direction: DESC
  - type: srh-fold
    name: 🎯 播客候选
    filters:
      and:
        - file.inFolder("ai-workspace-hub/output/podcast-picks")
        - pick_status == "candidate"
    groupBy:
      property: date
      direction: DESC
    order:
      - title_zh
      - tldr_zh
      - channel
      - guest
    sort:
      - property: published_at
        direction: DESC
  - type: srh-fold
    name: ✅ 已选待转录
    filters:
      and:
        - file.inFolder("ai-workspace-hub/output/podcast-picks")
        - pick_status == "selected"
    groupBy:
      property: date
      direction: DESC
    order:
      - title_zh
      - tldr_zh
      - channel
      - guest
    sort:
      - property: published_at
        direction: DESC
  - type: srh-fold
    name: 📝 已转录
    filters:
      or:
        - and:
            - file.inFolder("ai-workspace-hub/output/podcast-picks")
            - pick_status == "transcribed"
        - and:
            - file.inFolder("ai-workspace-hub/wiki/sources")
            - pick_status == "transcribed"
    groupBy:
      property: date
      direction: DESC
    order:
      - title_zh
      - tldr_zh
      - channel
      - guest
    sort:
      - property: date
        direction: DESC
  - type: srh-fold
    name: 🚀 已发布
    filters:
      or:
        - and:
            - file.inFolder("ai-workspace-hub/output/podcast-picks")
            - pick_status == "published"
        - and:
            - file.inFolder("ai-workspace-hub/wiki/sources")
            - pick_status == "published"
    groupBy:
      property: date
      direction: DESC
    order:
      - title_zh
      - tldr_zh
      - channel
      - guest
    sort:
      - property: date
        direction: DESC
  - type: table
    name: 🔬 研究
    filters:
      and:
        - file.inFolder("ai-workspace-hub/output/research")
        - formula.status != "跳过"
    order:
      - formula.status_icon
      - file.name
      - file.mtime
    sort:
      - property: file.mtime
        direction: DESC
  - type: table
    name: 🔍 筛选
    filters:
      and:
        - file.inFolder("ai-workspace-hub/output/screen")
        - formula.status != "跳过"
    order:
      - formula.status_icon
      - file.name
      - file.ctime
    sort:
      - property: file.ctime
        direction: DESC
    limit: 30
  - type: table
    name: 📚 Wiki
    filters:
      and:
        - file.inFolder("ai-workspace-hub/output/pod2wiki")
        - formula.status == "未读"
    order:
      - formula.status_icon
      - file.name
      - formula.days_old
    sort:
      - property: file.ctime
        direction: DESC
    columnSize:
      file.name: 201
  - type: table
    name: 📚 Sources（近30天未读）
    filters:
      and:
        - file.inFolder("ai-workspace-hub/wiki/sources")
        - formula.status == "未读"
        - (now() - file.ctime).days <= 30
    order:
      - formula.status_icon
      - file.name
      - formula.days_old
    sort:
      - property: file.ctime
        direction: DESC
    columnSize:
      file.name: 533
  - type: table
    name: ⭐ 精读清单
    filters:
      and:
        - read_status == "精读"
    order:
      - formula.status_icon
      - file.name
      - formula.category
      - formula.days_old
    sort:
      - property: file.ctime
        direction: DESC
  - type: table
    name: ✅ 最近已读
    filters:
      and:
        - read_status == "已读"
    order:
      - formula.status_icon
      - file.name
      - formula.category
      - formula.days_old
    sort:
      - property: file.mtime
        direction: DESC
    limit: 30

